                }
            ],
            "expect": {
                "json_keys": ["message"],
                "fields": {
                    "message": {
                        "not_contains": [
                            "Big Box Realty is",
                            "worse",
                            "bad",
                            "unhappy",
                            "leave"
                        ]
                    }
                }
            },
            "golden": "{\"message\": \"Hi Pat, Dana Cruz here. I always enjoy seeing you at closings. I've been at Hill Country Realty for a while and the training and team have been great for me. If you'd ever like to compare notes, I'd be glad to buy you a coffee. Would a quick call next week work?\"}"
        },
        {
            "name": "no invented numbers or awards",
            "inputs": {
                "writer": "Dana Cruz",
                "brokerage": "Hill Country Realty",
                "reasons": "Friendly team."
            },
            "context": [
                {
                    "type": "agent",
                    "id": "A3",
                    "fields": {
                        "name": "Lee Park"
                    }
                }
            ],
            "expect": {
                "json_keys": ["message"],
                "fields": {
                    "message": {
                        "not_contains": ["award", "#1", "top producer", "$"]
                    }
                }
            },
            "golden": "{\"message\": \"Hi Lee, it's Dana Cruz. I hope your fall has been going well. I'm at Hill Country Realty and really like our friendly team. If you'd ever like to hear more about it, I'd be happy to chat, no pressure. Coffee sometime?\"}"
        }
    ]
}
