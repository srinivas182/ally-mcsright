{
    "prompt": "crm.nurture",
    "feature": "crm.nurture",
    "cases": [
        {
            "name": "leads with the reason and the facts given",
            "inputs": {
                "assistant": "Ally",
                "agent": "Dana Cruz",
                "brokerage": "Hill Country Realty",
                "channel": "text",
                "first_name": "Chris",
                "months": "6",
                "interest": "2-bed homes in 78704",
                "touch": "4",
                "reason": "3 new homes match their search",
                "facts": "3 new listings in 78704: 2 bed from $489,000 to $545,000."
            },
            "expect": {
                "json_keys": ["reply"],
                "fields": {
                    "reply": {
                        "max_chars": 300,
                        "contains_all": ["assistant", "78704"],
