                            "family",
                            "kids",
                            "safe",
                            "hurry",
                            "act now",
                            "won't last"
                        ]
                    }
                }
            },
            "golden": "{\"reply\": \"Hi Chris, I'm Dana Cruz's AI assistant at Hill Country Realty. 3 new 2-bed homes just listed in 78704, from $489,000 to $545,000. Still looking in 78704?\"}"
        },
        {
