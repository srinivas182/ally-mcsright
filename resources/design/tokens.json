{
    "$description": "RightAlly design tokens. Source of truth for colour seeds, type, spacing, radius, elevation and motion. Neutral defaults until the Figma visual direction is approved; replacing values here restyles every component. Regenerate with: php artisan design:tokens",
    "color": {
        "brand": "#2F4FD8",
        "neutralTint": 0.012
    },
    "font": {
        "sans": "'Instrument Sans', ui-sans-serif, system-ui, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "radius": {
        "base": "0.625rem"
    },
    "shadow": {
        "xs": "0 1px 2px 0 rgb(15 23 42 / 0.05)",
        "sm": "0 1px 3px 0 rgb(15 23 42 / 0.08), 0 1px 2px -1px rgb(15 23 42 / 0.08)",
        "md": "0 4px 6px -1px rgb(15 23 42 / 0.08), 0 2px 4px -2px rgb(15 23 42 / 0.06)",
        "lg": "0 10px 15px -3px rgb(15 23 42 / 0.08), 0 4px 6px -4px rgb(15 23 42 / 0.05)",
        "xl": "0 20px 25px -5px rgb(15 23 42 / 0.10), 0 8px 10px -6px rgb(15 23 42 / 0.06)"
    },
    "motion": {
        "duration-fast": "120ms",
        "duration-base": "200ms",
        "duration-slow": "320ms",
        "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
        "ease-emphasized": "cubic-bezier(0.3, 0, 0, 1.3)"
    },
    "zIndex": {
        "dropdown": "1000",
        "sticky": "1100",
        "overlay": "1200",
        "modal": "1300",
        "toast": "1400"
    }
}
