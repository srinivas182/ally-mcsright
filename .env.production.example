# RightAlly on a server (DP1, docs/ops/01-vps-whm-deploy.md). Copy to .env on the server and fill in every CHANGE_ME.
# Never commit the filled-in file. Keys for outside services (Stripe, Twilio, MLS, email …) go in HQ › Outside services
# and AI keys in HQ › AI console, not here.

APP_NAME=RightAlly
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show  (run once; keep the key safe: it unlocks every encrypted value)
APP_KEY=CHANGE_ME
APP_URL=https://app.rightally.app
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
LOG_LEVEL=info

# --- Addresses (all one level under rightally.app, covered by Cloudflare's free certificate) ---------------------
# rightally.app + www: RightAlly's own website · app.rightally.app: HQ · {brokerage}.rightally.app: each back office
CORE_PLATFORM_DOMAIN=rightally.app
CORE_HQ_HOST=app.rightally.app
CORE_SSO_HOST=auth.rightally.app
CORE_MCP_HOST=mcp.rightally.app
MARKETING_HOSTS=rightally.app,www.rightally.app
CRM_INBOUND_EMAIL_DOMAIN=inbound.rightally.app
CRM_INBOUND_EMAIL_SECRET=CHANGE_ME
# One domain (DM1): a brokerage's public website is name.rightally.app and its back office name-office.rightally.app
# (name.rightally.app/backoffice leads there). Brokerages' own domains point (CNAME) at SITES_CNAME_TARGET.
# Needs only *.rightally.app on Cloudflare. For websites on a separate domain instead, set SITES_PLATFORM_DOMAIN to it
# and leave CORE_OFFICE_SUFFIX empty.
CORE_OFFICE_SUFFIX=-office
SITES_PLATFORM_DOMAIN=rightally.app
SITES_CNAME_TARGET=sites.rightally.app
CORE_BREACHED_PASSWORD_CHECK=true
# Requests arrive through WHM's Apache on Docker's network (private ranges are trusted by default).
TRUSTED_PROXIES=
CSP_MODE=report
DEMO_ENABLED=false

# --- Database and Redis (inside Docker; compose.prod.yaml reads these too) --------------------------------------
DB_CONNECTION=mysql
DB_DATABASE=rightally
DB_USERNAME=rightally
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
REDIS_CLIENT=phpredis
REDIS_PASSWORD=CHANGE_ME
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

# --- Files: on the server for now. To use Cloudflare R2 (or DigitalOcean Spaces / S3) instead, set s3 and the
# --- AWS_* values: moving servers then needs no file copy.
FILESYSTEM_DISK=local
LISTINGS_MEDIA_DISK=public
SITES_MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Email: set up in HQ › Outside services › Platform email (Brevo recommended, Postmark or Amazon SES). Until it is
# --- switched on, mail is written to the app's log (find a link with: docker compose -f compose.prod.yaml logs app).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@rightally.app
MAIL_FROM_NAME=RightAlly

# --- Watchtower (specs/core/20): who gets problem emails until HQ names people ----------------------------------
WATCHTOWER_EMAILS=CHANGE_ME

# --- AI providers: paste each key in HQ › AI console › Providers › API key (saved encrypted). Leave these empty; ------
# --- a key here is only used when none is saved in HQ.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Signed documents --------------------------------------------------------------------------------------------
FORMS_SEAL_SEED=
FORMS_IDENTITY_DRIVER=stripe
FORMS_LIBRARIES=test

# --- How much of the server RightAlly may use (raise these on a bigger or dedicated server) ---------------------
RIGHTALLY_PORT=8100
APP_MEMORY=2g
APP_CPUS=1.5
FPM_MAX_CHILDREN=16
QUEUE_WORKERS=2
QUEUE_MEMORY=768m
QUEUE_CPUS=1
MYSQL_MEMORY=2g
MYSQL_CPUS=1
MYSQL_BUFFER_POOL=1G

# Testing only: pause two-step sign-in until a date (YYYY-MM-DD, at most 30 days ahead). launch:check reports it.
# SECURITY_TWO_FACTOR_PAUSED_UNTIL=
